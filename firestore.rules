rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isViewer() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'viewer'];
    }

    // ── New screens (collections named fo_*) ─────────────────────────────
    // Roles: admin (Owner), manager, entry (Data entry), viewer.
    function hasRole(roles) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }
    function canSeeMoney() { return hasRole(['admin', 'manager', 'viewer']); }
    function canWrite()    { return hasRole(['admin', 'manager']); }
    function canLog()      { return hasRole(['admin', 'manager', 'entry']); }
    function anyRole()     { return hasRole(['admin', 'manager', 'entry', 'viewer']); }

    // Users
    match /users/{userId} {
      allow read:        if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Pending logins
    match /pending_logins/{uid} {
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow read, delete:   if isAdmin();
    }

    // Audit log — anyone signed in can write, only admin can read
    match /audit_log/{id} {
      allow read:   if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // audit logs are immutable
    }

    // Tea Plantation
    match /tea_harvest/{id}        { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_market_rates/{id}   { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_settlements/{id}    { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_agent_payments/{id} { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_advances/{id}       { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_maintenance/{id}    { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_inventory/{id}      { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_weather/{id}        { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tea_field_leases/{id}   { allow read: if isViewer(); allow write: if isAdmin(); }
    match /workers/{id}            { allow read: if isViewer(); allow write: if isAdmin(); }
    match /agents/{id}             { allow read: if isViewer(); allow write: if isAdmin(); }
    match /fields/{id}             { allow read: if isViewer(); allow write: if isAdmin(); }

    // Rental Homes
    match /properties/{id}          { allow read: if isViewer(); allow write: if isAdmin(); }
    match /tenants/{id}             { allow read: if isViewer(); allow write: if isAdmin(); }
    match /leases/{id}              { allow read: if isViewer(); allow write: if isAdmin(); }
    match /rental_transactions/{id} { allow read: if isViewer(); allow write: if isAdmin(); }

    // Home Maintenance
    match /home_properties/{id} { allow read: if isViewer(); allow write: if isAdmin(); }
    match /home_expenses/{id}   { allow read: if isViewer(); allow write: if isAdmin(); }

    // What Data entry needs in order to log a harvest or field work.
    // Records are never destroyed from the screens (delete = recycle bin,
    // which is an update); only the Owner can destroy from the bin.
    match /fo_deliveries/{id} { allow read: if anyRole(); allow create, update: if canLog(); allow delete: if isAdmin(); }
    match /fo_work/{id}       { allow read: if anyRole(); allow create, update: if canLog(); allow delete: if isAdmin(); }
    match /fo_notes/{id}      { allow read: if anyRole(); allow create, update: if canLog(); allow delete: if isAdmin(); }
    match /fo_rain/{id}       { allow read: if anyRole(); allow create, update: if canLog(); allow delete: if isAdmin(); }
    match /fo_people/{id}     { allow read: if anyRole(); allow create, update: if canWrite(); allow delete: if isAdmin(); }
    match /fo_fields/{id}     { allow read: if anyRole(); allow create, update: if canWrite(); allow delete: if isAdmin(); }
    match /fo_stock/{id}      { allow read: if anyRole(); allow create, update: if canWrite(); allow delete: if isAdmin(); }
    match /fo_settings/{id}   { allow read: if anyRole(); allow create, update: if canWrite(); allow delete: if isAdmin(); }

    // Money: not readable by Data entry.
    match /fo_entries/{id}    { allow read: if canSeeMoney(); allow create, update: if canWrite(); allow delete: if isAdmin(); }
    match /fo_tenancies/{id}  { allow read: if canSeeMoney(); allow create, update: if canWrite(); allow delete: if isAdmin(); }
    match /fo_properties/{id} { allow read: if canSeeMoney(); allow create, update: if canWrite(); allow delete: if isAdmin(); }
    match /fo_equipment/{id}  { allow read: if canSeeMoney(); allow create, update: if canWrite(); allow delete: if isAdmin(); }
    match /fo_leases/{id}     { allow read: if canSeeMoney(); allow create, update: if canWrite(); allow delete: if isAdmin(); }

    // History of changes: written with every change, never altered or removed.
    match /fo_history/{id} {
      allow read:   if canSeeMoney();
      allow create: if canLog();
      allow update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
